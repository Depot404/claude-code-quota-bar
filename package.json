{
  "name": "claude-code-quota-bar",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "2.72.0",
  "publisher": "AnthonyDame",
  "license": "MIT",
  "icon": "images/icon.png",
  "author": {
    "name": "Anthony Dame"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Depot404/claude-code-quota-bar"
  },
  "bugs": {
    "url": "https://github.com/Depot404/claude-code-quota-bar/issues"
  },
  "homepage": "https://github.com/Depot404/claude-code-quota-bar#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "claude-code",
    "quota",
    "usage",
    "usage tracker",
    "conversations",
    "conversation manager",
    "sidebar",
    "anthropic",
    "notifications",
    "sound",
    "burn rate",
    "context window",
    "focus window",
    "parallel",
    "orchestration",
    "multi-agent",
    "batch",
    "waves",
    "handoff",
    "status"
  ],
  "galleryBanner": {
    "color": "#1F1F1F",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "claudeCodeQuotaBar",
          "title": "%viewContainer.title%",
          "icon": "images/panel-icon.svg"
        }
      ]
    },
    "views": {
      "claudeCodeQuotaBar": [
        {
          "id": "claudeCodeQuotaBar.panel",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claude-code-quota-bar.open",
        "title": "%command.open.title%"
      },
      {
        "command": "claude-code-quota-bar.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "claude-code-quota-bar.installHooks",
        "title": "%command.installHooks.title%"
      },
      {
        "command": "claude-code-quota-bar.installBatchPhilosophy",
        "title": "%command.installBatchPhilosophy.title%"
      },
      {
        "command": "claude-code-quota-bar.showPanel",
        "title": "%command.showPanel.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "claudeCodeQuotaBar.refreshIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 120,
          "description": "%config.refreshIntervalMinutes.description%"
        },
        "claudeCodeQuotaBar.burnRateGreenMax": {
          "type": "number",
          "default": 0.85,
          "minimum": 0,
          "description": "%config.burnRateGreenMax.description%"
        },
        "claudeCodeQuotaBar.burnRateYellowMax": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "%config.burnRateYellowMax.description%"
        },
        "claudeCodeQuotaBar.ctxRedMin": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.ctxRedMin.description%"
        },
        "claudeCodeQuotaBar.ctxYellowMin": {
          "type": "number",
          "default": 40,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.ctxYellowMin.description%"
        },
        "claudeCodeQuotaBar.costRedDollars": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%config.costRedDollars.description%"
        },
        "claudeCodeQuotaBar.costYellowDollars": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "%config.costYellowDollars.description%"
        },
        "claudeCodeQuotaBar.costTurnRedDollars": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "%config.costTurnRedDollars.description%"
        },
        "claudeCodeQuotaBar.costTurnYellowDollars": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "description": "%config.costTurnYellowDollars.description%"
        },
        "claudeCodeQuotaBar.relayNoticeDollars": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "%config.relayNoticeDollars.description%"
        },
        "claudeCodeQuotaBar.sounds.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.sounds.enabled.description%"
        },
        "claudeCodeQuotaBar.conversationSortOrder": {
          "type": "string",
          "enum": [
            "tabOrder",
            "lastActivity",
            "statusFirst"
          ],
          "enumDescriptions": [
            "%config.conversationSortOrder.enum.tabOrder%",
            "%config.conversationSortOrder.enum.lastActivity%",
            "%config.conversationSortOrder.enum.statusFirst%"
          ],
          "default": "tabOrder",
          "description": "%config.conversationSortOrder.description%"
        },
        "claudeCodeQuotaBar.collapsedConversations": {
          "type": "boolean",
          "default": false,
          "description": "%config.collapsedConversations.description%"
        },
        "claudeCodeQuotaBar.collapsedQuota": {
          "type": "boolean",
          "default": false,
          "description": "%config.collapsedQuota.description%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "finishSetup",
            "title": "%walkthrough.step.finishSetup.title%",
            "description": "%walkthrough.step.finishSetup.description%",
            "media": {
              "svg": "walkthrough/step-install.svg",
              "altText": "%walkthrough.step.finishSetup.media.altText%"
            },
            "completionEvents": [
              "onCommand:claude-code-quota-bar.installHooks",
              "onContext:claudeCodeQuotaBar.hooksInstalled && claudeCodeQuotaBar.handoffsInstalled"
            ]
          },
          {
            "id": "launchBatch",
            "title": "%walkthrough.step.launchBatch.title%",
            "description": "%walkthrough.step.launchBatch.description%",
            "media": {
              "svg": "walkthrough/step-batch.svg",
              "altText": "%walkthrough.step.launchBatch.media.altText%"
            },
            "completionEvents": [
              "onCommand:claude-code-quota-bar.showPanel"
            ]
          },
          {
            "id": "handoffsCommand",
            "title": "%walkthrough.step.handoffsCommand.title%",
            "description": "%walkthrough.step.handoffsCommand.description%",
            "media": {
              "svg": "walkthrough/step-handoffs.svg",
              "altText": "%walkthrough.step.handoffsCommand.media.altText%"
            },
            "completionEvents": [
              "onContext:claudeCodeQuotaBar.handoffsInstalled"
            ]
          },
          {
            "id": "batchPhilosophy",
            "title": "%walkthrough.step.batchPhilosophy.title%",
            "description": "%walkthrough.step.batchPhilosophy.description%",
            "media": {
              "svg": "walkthrough/step-philosophy.svg",
              "altText": "%walkthrough.step.batchPhilosophy.media.altText%"
            },
            "completionEvents": [
              "onCommand:claude-code-quota-bar.installBatchPhilosophy"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "l10n": "./l10n"
}
